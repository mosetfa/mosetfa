plot_data <- base %>%
  mutate(Season = factor(Season, levels = season_order)) %>%
  select(Season, WQI_P, WQI_2P, WA_WQI, WA_WQI2) %>%
  pivot_longer(
    cols = -Season,
    names_to = "Index",
    values_to = "Value"
  ) %>%
  mutate(
    Index_group = case_when(
      Index %in% c("WQI_P", "WQI_2P") ~ "Aggregated PCA-based indices",
      TRUE ~ "Reference indices"
    ),
    Index = recode(
      Index,
      WQI_P = "WQI_P (first selection)",
      WQI_2P = "WQI_2P (second selection)",
      WA_WQI = "WA_WQI (first selection)",
      WA_WQI2 = "WA_WQI2 (second selection)"
    )
  )

ggplot(plot_data, aes(x = Season, y = Value, fill = Index)) +
  geom_boxplot(
    position = position_dodge(width = 0.8),
    width = 0.65,
    outlier.shape = NA
  ) +
  geom_point(
    aes(colour = Index),
    position = position_jitterdodge(
      jitter.width = 0.08,
      dodge.width = 0.8
    ),
    alpha = 0.65,
    size = 1.8
  ) +
  facet_wrap(~ Index_group, scales = "free_y") +
  labs(
    x = NULL,
    y = "Water quality index value",
    fill = "Index",
    colour = "Index"
  ) +
  theme_bw() +
  theme(
    legend.position = "bottom",
    axis.text.x = element_text(angle = 25, hjust = 1),
    strip.background = element_rect(fill = "grey95")
  )
