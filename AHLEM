# 4. Scatterplot function
make_scatter <- function(x, y, xlab, ylab, title) {
  
  plot_data <- data.frame(x = x, y = y)
  
  ggplot(plot_data, aes(x = x, y = y)) +
    geom_point(size = 2.5, alpha = 0.8) +
    geom_abline(
      slope = 1, intercept = 0,
      linetype = "dashed", linewidth = 0.8
    ) +
    labs(
      title = title,
      x = xlab,
      y = ylab
    ) +
    theme_bw(base_size = 12) +
    theme(
      plot.title = element_text(face = "bold"),
      aspect.ratio = 1
    )
}

# 5. Bland-Altman plot function
make_bland_altman <- function(x, y, title) {
  
  difference <- y - x
  mean_pair <- (x + y) / 2
  
  bias <- mean(difference)
  sd_diff <- sd(difference)
  
  loa_upper <- bias + 1.96 * sd_diff
  loa_lower <- bias - 1.96 * sd_diff
  
  plot_data <- data.frame(
    Mean = mean_pair,
    Difference = difference
  )
  
  ggplot(plot_data, aes(x = Mean, y = Difference)) +
    geom_point(size = 2.5, alpha = 0.8) +
    geom_hline(
      yintercept = bias,
      linewidth = 0.8
    ) +
    geom_hline(
      yintercept = loa_upper,
      linetype = "dashed"
    ) +
    geom_hline(
      yintercept = loa_lower,
      linetype = "dashed"
    ) +
    labs(
      title = title,
      x = "Mean of the two index values",
      y = "Difference (second - first)"
    ) +
    theme_bw(base_size = 12) +
    theme(
      plot.title = element_text(face = "bold")
    )
}

