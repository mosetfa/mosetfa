            aes(x=NMDS1*1.1, y=NMDS2*1.1, label=species),
            color="darkred", size=3) +
  labs(title="NMDS1: Insect Species Composition Across Stations",
       subtitle=paste0("Stress: ", round(nmds1$stress, 4)),
       x="NMDS1", y="NMDS2") +
  theme_minimal(base_size=14)

# ===========================
# NMDS 2: Species + Environmental Vectors Only
# ===========================
set.seed(123)
nmds2 <- metaMDS(species_data, distance="bray", k=2, trymax=100)

# Species arrows
species_vectors2 <- as.data.frame(scores(nmds2, display="species"))
colnames(species_vectors2) <- c("NMDS1","NMDS2")
species_vectors2$species <- rownames(species_vectors2)

# Environmental arrows
envfit2 <- envfit(nmds2 ~ ., data=env_data, permutations=999)
env_vectors2 <- as.data.frame(scores(envfit2, display="vectors"))
colnames(env_vectors2) <- c("NMDS1","NMDS2")
env_vectors2$variable <- rownames(env_vectors2)

# Plot NMDS 2
ggplot() +
  # Species arrows
  geom_segment(data=species_vectors2,
               aes(x=0, y=0, xend=NMDS1, yend=NMDS2),
               arrow=arrow(length=unit(0.3,"cm")), color="darkred") +
  geom_text(data=species_vectors2,
            aes(x=NMDS1*1.1, y=NMDS2*1.1, label=species),
            color="darkred", size=3) +
  # Environmental arrows
  geom_segment(data=env_vectors2,
               aes(x=0, y=0, xend=NMDS1, yend=NMDS2),
               arrow=arrow(length=unit(0.3,"cm")), color="black") +
  geom_text(data=env_vectors2,
            aes(x=NMDS1*1.1, y=NMDS2*1.1, label=variable),
            color="black", size=4) +
  labs(title="NMDS 2 - Species + Environmental Vectors Only",
       subtitle=paste0("Stress: ", round(nmds2$stress, 4)),
       x="NMDS1", y="NMDS2") +
  theme_minimal(base_size=14)

