  y_train <- y[train_index]
  y_test  <- y[-train_index]
  
  ctrl <- trainControl(method = "repeatedcv", number = 5, repeats = 5)
  
  # 🔑 Random search grid for alpha and lambda
  random_grid <- data.frame(
    alpha  = runif(20, 0, 1),              # 20 random alpha values between 0 and 1
    lambda = 10^runif(20, -4, 1)           # 20 random lambda values (10^-4 to 10^1)
