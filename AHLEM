library(caret)
library(glmnet)
library(Metrics)

targets <- c("WQI","CCME","WQI_P",
             "WQI_D1","WQI_D2","WQI_D3","WQI_D4","WQI_D5")

run_elasticnet <- function(target){
  
  set.seed(123)
  
  df <- base[, c(target, "TH","NT","Na","BOD5","turb","T","NO3","NO2")]
  df <- na.omit(df)
  
  y <- df[[target]]
  X <- df[, -1]
  
  train_index <- createDataPartition(y, p = 0.7, list = FALSE)
  
  X_train <- X[train_index, ]
  X_test <- X[-train_index, ]
  
  y_train <- y[train_index]
  y_test <- y[-train_index]
  
  ctrl <- trainControl(
    method = "repeatedcv",
    number = 5,
    repeats = 5
  )
  
  model <- train(
    x = X_train,
    y = y_train,
    method = "glmnet",
    trControl = ctrl,
    tuneLength = 25
  )
  
  pred_train <- predict(model, X_train)
  pred_test <- predict(model, X_test)
  
  cat("\n========================\n")
  cat("INDEX:", target, "\n")
  cat("========================\n")
  
  cat("\nTRAIN:\n")
  cat("RMSE =", RMSE(pred_train, y_train), "\n")
  cat("MAE =", MAE(pred_train, y_train), "\n")
  cat("R2 =", cor(pred_train, y_train)^2, "\n")
  
  cat("\nTEST:\n")
  cat("RMSE =", RMSE(pred_test, y_test), "\n")
  cat("MAE =", MAE(pred_test, y_test), "\n")
  cat("R2 =", cor(pred_test, y_test)^2, "\n")
  
  return(model)
  
}

results <- lapply(targets, run_elasticnet)
names(results) <- targets

