# 2. Function for numerical agreement statistics
agreement_stats <- function(x, y) {
  
  difference <- y - x
  bias <- mean(difference)
  sd_diff <- sd(difference)
  
  data.frame(
    N = length(x),
    MAE = mean(abs(difference)),
    RMSE = sqrt(mean(difference^2)),
    R2_correlation = cor(x, y)^2,
    Spearman_rho = cor(x, y, method = "spearman"),
    Mean_bias = bias,
    Lower_LOA = bias - 1.96 * sd_diff,
    Upper_LOA = bias + 1.96 * sd_diff
  )
}

# 3. Calculate statistics for both index comparisons
