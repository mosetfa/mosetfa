# ============================================================
# 4. FUNCTION TO CREATE ONE SELECTION-PROCESS FIGURE
# ============================================================

make_selection_figure <- function(index_names, figure_title) {
  
  plot_data <- metrics_long %>%
    filter(Index %in% index_names)
  
  make_panel <- function(metric_name, panel_title, y_label) {
    
    d <- plot_data %>%
      filter(Metric == metric_name)
    
    ymax <- max(d$Value, na.rm = TRUE)
    
    # Shared y-axis across the two indices in this panel
    upper_limit <- if (metric_name == "R2") {
      max(1.05, ymax * 1.10)
    } else {
      ymax * 1.15
    }
    
    ggplot(
      d,
      aes(x = Model, y = Value, fill = Dataset)
    ) +
      geom_col(
        position = position_dodge(width = 0.82),
        width = 0.70,
        color = "black",
        linewidth = 0.25
      ) +
      geom_text(
        aes(label = sprintf("%.2f", Value)),
        position = position_dodge(width = 0.82),
        vjust = -0.30,
        size = 2.7
      ) +
      facet_wrap(
        ~ Index,
        ncol = 2,
        scales = "fixed"
      ) +
      scale_fill_brewer(palette = "Paired") +
      scale_y_continuous(
        limits = c(0, upper_limit),
        breaks = scales::breaks_pretty(n = 5),
        expand = expansion(mult = c(0, 0.02))
      ) +
      labs(
        title = panel_title,
        x = "Algorithm",
        y = y_label,
        fill = "Dataset"
      ) +
      theme_minimal(base_size = 11) +
      theme(
        plot.title = element_text(
          face = "bold",
          hjust = 0.5
        ),
        strip.text = element_text(face = "bold"),
        axis.text.x = element_text(
          angle = 15,
          hjust = 1
        ),
        legend.position = "bottom",
        panel.grid.minor = element_blank()
      )
  }
  
  p_rmse <- make_panel("RMSE", "RMSE", "RMSE")
  p_mae  <- make_panel("MAE", "MAE", "MAE")
  p_r2   <- make_panel(
    "R2",
    expression(R^2),
    expression("Predictive " * R^2)
  )
  
  # Stack RMSE, MAE, and R² panels into one figure
  (p_rmse / p_mae / p_r2) +
    plot_annotation(
      title = figure_title,
      theme = theme(
        plot.title = element_text(
          face = "bold",
          size = 15,
          hjust = 0.5
        )
      )
    )
}


