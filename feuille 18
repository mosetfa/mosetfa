# 📦 Packages
library(dplyr)
library(tidyr)
library(rstatix)
library(ggplot2)
library(ggpubr)

# 🔹 Jeu de données
data <- base

# 🔹 Mise en format long
data_long <- data %>%
  pivot_longer(
    cols = -c(STATIONS, groups),
    names_to = "variable",
    values_to = "value"
  )

# 🔹 Moyennes et SE
summary_data <- data_long %>%
  group_by(variable, groups) %>%
  summarise(
    mean = mean(value, na.rm = TRUE),
    se = sd(value, na.rm = TRUE) / sqrt(n()),
    .groups = "drop"
  )

# 🔹 Test de Kruskal–Wallis
kw_results <- data_long %>%
  group_by(variable) %>%
  kruskal_test(value ~ groups)

# 🔹 Test post-hoc de Dunn
dunn_results <- data_long %>%
  group_by(variable) %>%
  dunn_test(value ~ groups, p.adjust.method = "bonferroni") %>%
  add_significance("p.adj")

# 🔹 Ajouter positions verticales (y.position)
y_positions <- summary_data %>%
  group_by(variable) %>%
  summarise(y.position = max(mean + se, na.rm = TRUE) * 1.1)

# 🔹 Fusionner
dunn_results_ready <- dunn_results %>%
  left_join(y_positions, by = "variable") %>%
  mutate(
    group1 = as.character(group1),
    group2 = as.character(group2)
  )

# 🔹 Graphique
p <- ggplot(summary_data, aes(x = groups, y = mean)) +
  geom_bar(stat = "identity", position = position_dodge(0.8),
           width = 0.7, fill = "#80b1d3") +
  geom_errorbar(aes(ymin = mean - se, ymax = mean + se),
                width = 0.2, position = position_dodge(0.8)) +
  facet_wrap(~variable, scales = "free_y") +
  stat_pvalue_manual(
    dunn_results_ready,
    label = "p.adj.signif",
    tip.length = 0.01,
    hide.ns = TRUE
  ) +
  labs(
    title = "Comparaison between groups (Kruskal–Wallis +  Dunn test)",
    subtitle = paste0(
      "Kruskal–Wallis : "
    ),
    x = "Groups",
    y = "means ± SE"
  ) +
  theme_minimal(base_size = 13) +
  theme(
    legend.position = "none",
    strip.text = element_text(face = "bold"),
    axis.text.x = element_text(angle = 0, vjust = 0.5)
  )

