##Monte carlo for randa paper WQI_D4
# ==========================================================
# 9. Monte Carlo Cross-Validation (100 repetitions)
# ==========================================================

library(caret)
library(glmnet)
library(dplyr)
library(openxlsx)

set.seed(123)

n.sim <- 100

# Metric functions
rmse_calc <- function(obs, pred){
  sqrt(mean((obs - pred)^2))
}

mae_calc <- function(obs, pred){
  mean(abs(obs - pred))
}

r2_calc <- function(obs, pred){
  cor(obs, pred)^2
}

# Empty results table
MC_results <- data.frame()

# ==========================================================
# Monte Carlo loop
# ==========================================================

for(i in 1:n.sim){
  
  ## Random train/test split (70/30)
  
  trainIndex <- createDataPartition(
    data_model$WQI_D4,
    p = 0.70,
    list = FALSE
  )
  
  trainData <- data_model[trainIndex, ]
  testData  <- data_model[-trainIndex, ]
  
  ## Design matrices
  
  x_train <- model.matrix(
    WQI_D4 ~ HCO3 + Period,
    data = trainData
  )[,-1]
  
  y_train <- trainData$WQI_D4
  
  x_test <- model.matrix(
    WQI_D4 ~ HCO3 + Period,
    data = testData
  )[,-1]
  
  y_test <- testData$WQI_D4
  
  ## Models (10-fold CV)
  
  lasso <- cv.glmnet(
    x_train,
    y_train,
    alpha = 1,
    nfolds = 10
  )
  
  ridge <- cv.glmnet(
    x_train,
    y_train,
    alpha = 0,
    nfolds = 10
  )
  
  enet <- cv.glmnet(
    x_train,
    y_train,
    alpha = 0.5,
    nfolds = 10
  )
  
  ## Predictions
  
  pred_lasso <- as.numeric(
    predict(lasso,
            s = "lambda.min",
            newx = x_test)
  )
  
  pred_ridge <- as.numeric(
    predict(ridge,
            s = "lambda.min",
            newx = x_test)
  )
  
  pred_enet <- as.numeric(
    predict(enet,
            s = "lambda.min",
            newx = x_test)
  )
  
  ## Save metrics
  
  MC_results <- rbind(
    
    MC_results,
    
    data.frame(
      Iteration = i,
      Model = "Lasso",
      RMSE = rmse_calc(y_test,pred_lasso),
      MAE  = mae_calc(y_test,pred_lasso),
      R2   = r2_calc(y_test,pred_lasso)
    ),
    
    data.frame(
      Iteration = i,
      Model = "Ridge",
      RMSE = rmse_calc(y_test,pred_ridge),
      MAE  = mae_calc(y_test,pred_ridge),
      R2   = r2_calc(y_test,pred_ridge)
    ),
    
    data.frame(
      Iteration = i,
      Model = "Elastic Net",
      RMSE = rmse_calc(y_test,pred_enet),
      MAE  = mae_calc(y_test,pred_enet),
      R2   = r2_calc(y_test,pred_enet)
    )
    
  )
  
}




MC_summary <-
  
  MC_results %>%
  
  group_by(Model) %>%
  
  summarise(
    
    Mean_RMSE = mean(RMSE),
    Median_RMSE = median(RMSE),
    SD_RMSE = sd(RMSE),
    RMSE_Lower95 = quantile(RMSE,0.025),
    RMSE_Upper95 = quantile(RMSE,0.975),
    
    Mean_MAE = mean(MAE),
    Median_MAE = median(MAE),
    SD_MAE = sd(MAE),
    MAE_Lower95 = quantile(MAE,0.025),
    MAE_Upper95 = quantile(MAE,0.975),
    
    Mean_R2 = mean(R2),
    Median_R2 = median(R2),
    SD_R2 = sd(R2),
    R2_Lower95 = quantile(R2,0.025),
    R2_Upper95 = quantile(R2,0.975)
    
  )

MC_summary_WQI_D4=MC_summary
MC_results_WQI_D4=MC_results
library(ggplot2)

WQI_D4_RMSE=ggplot(MC_results,
       aes(x = RMSE,
