  geom_density(alpha = 0.35) +
  
  theme_minimal(base_size = 8) +
  
  labs(
    title = "Monte Carlo Cross-Validation Distribution of RMSE for WQI_D4",
    x = "RMSE",
    y = "Density"
  )

