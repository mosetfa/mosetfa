  y_test <- testData$WA_WQI
  
  ## Models
  
  lasso <- cv.glmnet(
    x_train,
    y_train,
    alpha = 1,
    nfolds = 10
  )
  
  ridge <- cv.glmnet(
    x_train,
    y_train,
    alpha = 0,
    nfolds = 10
  )
  
  enet <- cv.glmnet(
    x_train,
    y_train,
    alpha = 0.5,
    nfolds = 10
  )
  
  ## Predictions
  
  pred_lasso <- as.numeric(
    predict(
      lasso,
      s = "lambda.min",
      newx = x_test
    )
  )
  
  pred_ridge <- as.numeric(
    predict(
      ridge,
      s = "lambda.min",
      newx = x_test
    )
  )
  
  pred_enet <- as.numeric(
    predict(
      enet,
      s = "lambda.min",
      newx = x_test
    )
  )
  
  ## Save metrics
  
  MC_results <- rbind(
    
    MC_results,
    
    data.frame(
      Iteration = i,
      Model = "Lasso",
      RMSE = rmse_calc(y_test, pred_lasso),
      MAE  = mae_calc(y_test, pred_lasso),
      R2   = r2_calc(y_test, pred_lasso)
    ),
    
    data.frame(
      Iteration = i,
      Model = "Ridge",
      RMSE = rmse_calc(y_test, pred_ridge),
      MAE  = mae_calc(y_test, pred_ridge),
      R2   = r2_calc(y_test, pred_ridge)
    ),
    
    data.frame(
      Iteration = i,
      Model = "Elastic Net",
      RMSE = rmse_calc(y_test, pred_enet),
      MAE  = mae_calc(y_test, pred_enet),
      R2   = r2_calc(y_test, pred_enet)
    )
    
  )
  
}
