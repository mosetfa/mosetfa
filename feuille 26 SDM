data<-read.csv2("D:/moste/OneDrive/Bureau/SATOUR/DATA.csv")
# Load necessary libraries
library(dplyr)
library(ggplot2)
library(mgcv)  # For GAM smoothing

# Step 1: Compute species richness per year
richness_per_year <- data_seybouse %>%
  group_by(Year) %>%
  summarise(Species_Richness = n_distinct(Species))

# View result
print(richness_per_year)

# Step 2: Plot species richness over time with LOESS smoothing
ggplot(richness_per_year, aes(x = Year, y = Species_Richness)) +
  geom_point(color = "blue", size = 3) +
  geom_smooth(method = "loess", se = TRUE, color = "darkred", span = 0.75) +
  theme_minimal() +
  labs(title = "Species Richness Over Years",
       x = "Year",
       y = "Species Richness")

# Optional Step 3: Fit a GAM model for trend analysis
gam_model <- gam(Species_Richness ~ s(Year), data = richness_per_year)
summary(gam_model)

# Plot the GAM fitted curve
plot(gam_model, se = TRUE, col = "darkgreen", shade = TRUE, main = "GAM Fit of Species Richness Trend")
