# Load libraries
library(vegan)
library(glmnet)

# TITAN-selected families (≥0.8 purity/reliability)
titan_families <- c("Lumbriculidae", "Helobdella", "Asellus", "Leptoceridae", "Calopteryx")

# Extract abundance matrix
X <- data_station[, titan_families]

# Apply Hellinger transformation
X_hellinger <- decostand(X, method = "hellinger")

# List of response indices available in your dataset
indices <- c("Abundance", "Richness", "Shannon_H", "Simpson", 
             "Evenness", "BMWP_ITA", "ASPT_ITA")

# Run Elastic Net for each index
results <- list()

set.seed(123) # reproducibility
for (idx in indices) {
  y <- data_station[[idx]]
  
  cv_model <- cv.glmnet(as.matrix(X_hellinger), y,
                        alpha = 0.5,        # Elastic Net mixing parameter
                        nfolds = 16,        # leave-one-out CV since n=16
                        standardize = FALSE)
  
  # Store coefficients at lambda.min
  results[[idx]] <- coef(cv_model, s = "lambda.min")
}

# Inspect results for each index
results$Simpson
results$Evenness
results$Shannon_H
results$ASPT_ITA
results$BMWP_ITA
results$Richness
results$Abundance

