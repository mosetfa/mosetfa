# Load libraries
library(vegan)
library(glmnet)

# TITAN-selected families (≥0.8 purity/reliability)
titan_families <- c("Lumbriculidae", "Helobdella", "Asellus", "Leptoceridae", "Calopteryx")

# Predictor matrix (Hellinger transformed)
X <- data_station[, titan_families]
X_hellinger <- decostand(X, method = "hellinger")

# Indices to test
indices <- c("Abundance", "Richness", "Shannon_H", "Simpson", 
             "Evenness", "BMWP_ITA", "ASPT_ITA")

# Store CV models and summary results
cv_models <- list()
cv_errors <- data.frame(Index = indices, Min_CV_Error = NA, 
                        Lambda_Min = NA, Lambda_1se = NA)

set.seed(123) # reproducibility
for (idx in indices) {
  y <- data_station[[idx]]
  
  cv_model <- cv.glmnet(as.matrix(X_hellinger), y,
                        alpha = 0.5,        # Elastic Net mixing parameter
                        nfolds = 16,        # leave-one-out CV since n=16
                        standardize = FALSE)
  
  cv_models[[idx]] <- cv_model
  
  # Record CV error and lambda values
  cv_errors[cv_errors$Index == idx, "Min_CV_Error"] <- min(cv_model$cvm)
  cv_errors[cv_errors$Index == idx, "Lambda_Min"]   <- cv_model$lambda.min
  cv_errors[cv_errors$Index == idx, "Lambda_1se"]   <- cv_model$lambda.1se
}

# -----------------------------
# Step 2: Inspect results
# -----------------------------
# Print summary table of CV errors and lambda values
print(cv_errors)

# Example: plot CV curve for each index
par(mfrow = c(3,3)) # multi-panel layout
for (idx in indices) {
  plot(cv_models[[idx]], main = idx)
}
par(mfrow = c(1,1)) # reset layout

