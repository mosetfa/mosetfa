# =========================
# NO3 threshold (8 mg/L) community analysis (Bray-Curtis)
# NMDS + Shepard + envfit + PERMANOVA + betadisper
# =========================
library(vegan)
library(ggplot2)

# ---- 1) Create NO3 group based on 8 mg/L ----
base$NO3_group <- factor(ifelse(base$NO3 <= 8, "<=8", ">8"), levels = c("<=8", ">8"))

table(base$NO3_group, useNA = "ifany")

# ---- 2) Define the species (taxa) matrix ----
# In your file, last columns are: pH, Temperature, Conductivity, NO3, PO4, and we just created NO3_group.
# So species are everything EXCEPT those env columns.

env_cols <- c("pH", "Temperature", "Conductivity", "NO3", "PO4", "NO3_group")
species_cols <- setdiff(colnames(base), env_cols)

matrice_especes <- base[, species_cols]

# Safety: ensure numeric, replace NAs with 0 if needed (or use na.omit on rows)
matrice_especes <- as.data.frame(lapply(matrice_especes, as.numeric))
matrice_especes[is.na(matrice_especes)] <- 0

# Optional (recommended for abundance data): Wisconsin double standardization
# matrice_especes <- wisconsin(matrice_especes)

# ---- 3) Bray-Curtis distance ----
dist_bray <- vegdist(matrice_especes, method = "bray")

# ---- 4) NMDS (Bray-Curtis) ----
set.seed(123)
nmds <- metaMDS(matrice_especes,
                distance = "bray",
                k = 2,
                trymax = 200,
                autotransform = FALSE,
                trace = FALSE)

nmds
stress_value <- nmds$stress
stress_value

# Shepard / stress plot (base plot)
stressplot(nmds)

# ---- 5) NMDS plot with NO3 groups + stress ----
scores_sites <- as.data.frame(scores(nmds, display = "sites"))
scores_sites$NO3_group <- base$NO3_group
scores_sites$NO3 <- base$NO3

p_nmds <- ggplot(scores_sites, aes(x = NMDS1, y = NMDS2, color = NO3_group)) +
  geom_point(size = 3, alpha = 0.9) +
  stat_ellipse(level = 0.95) +
  annotate("text",
           x = min(scores_sites$NMDS1),
           y = max(scores_sites$NMDS2),
           label = paste0("Stress = ", round(stress_value, 3)),
           hjust = 0, vjust = 1, size = 4) +
  theme_bw() +
  labs(title = "NMDS (Bray–Curtis) by NO3 threshold (8 mg/L)",
       color = "NO3 group")

print(p_nmds)

# ---- 6) envfit: fit NO3 numeric + other env vars (optional) ----
# envfit works with numeric variables directly; factors are handled as centroids.
env_data <- base[, c("NO3", "PO4", "pH", "Temperature", "Conductivity", "NO3_group")]

set.seed(123)
fit <- envfit(nmds, env_data, perm = 999)
fit
plot(nmds, type = "n")
points(nmds, display = "sites", col = as.numeric(base$NO3_group), pch = 16)
ordihull(nmds, groups = base$NO3_group, draw = "polygon", col = as.numeric(base$NO3_group), alpha = 80)
plot(fit, p.max = 0.05)  # shows only significant vectors/centroids (p<=0.05)

# ---- 7) PERMANOVA (adonis2) for composition difference between NO3 groups ----
# Use the Bray distance object with adonis2:
set.seed(123)
permanova <- adonis2(dist_bray ~ NO3_group, data = base, permutations = 999)
permanova

# Optional: PERMANOVA with NO3 numeric (gradient) instead of threshold groups
set.seed(123)
permanova_no3 <- adonis2(dist_bray ~ NO3, data = base, permutations = 999)
permanova_no3

# Optional: combine (careful interpretation)
set.seed(123)
permanova_combo <- adonis2(dist_bray ~ NO3_group + pH + Temperature + Conductivity + PO4, data = base, permutations = 999)
permanova_combo

# ---- 8) betadisper (test homogeneity of dispersion) ----
bd <- betadisper(dist_bray, group = base$NO3_group)
bd

anova(bd)              # test difference in dispersion
permutest(bd, perm=999)

# Plot dispersions
plot(bd)
boxplot(bd, main = "Betadisper by NO3 group", xlab = "NO3 group", ylab = "Distance to centroid")
