    collapse = " + "
  ),
  Testing = sapply(
    scenarios,
    function(x) {
      paste(
        setdiff(dam_levels, x),
        collapse = " + "
      )
    }
  )
)

cat("\nSCENARIO DESIGN:\n")

print(scenario_design)

# ------------------------------------------------------------
# 6. DEFINE WATER QUALITY CLASSES
# ------------------------------------------------------------

classify_wqi <- function(x) {
  
  cut(
    x,
    breaks = c(
      -Inf, 25, 50, 75, 100, Inf
    ),
    labels = c(
      "Excellent",
      "Good",
      "Poor",
      "Very Poor",
      "Unsuitable"
    ),
    right = FALSE
  )
}

# ------------------------------------------------------------
# 7. DEFINE TRANSFERABILITY METRICS
# ------------------------------------------------------------

calculate_agreement <- function(reference, transferred) {
  
  # Spearman correlation
  rho <- suppressWarnings(
    cor(
      reference,
      transferred,
      method = "spearman",
      use = "complete.obs"
    )
  )
  
  # Mean absolute error
  MAE <- mean(
    abs(reference - transferred),
    na.rm = TRUE
  )
  
  # Classification agreement
  reference_class <- classify_wqi(reference)
  
  transferred_class <- classify_wqi(transferred)
  
  class_agreement <- 100 * mean(
    reference_class == transferred_class,
    na.rm = TRUE
  )
  
  return(
    data.frame(
      Spearman_rho = rho,
      MAE = MAE,
      Class_agreement = class_agreement
    )
  )
}

# ------------------------------------------------------------
# 8. RUN THE SIX TRANSFERABILITY SCENARIOS
# ------------------------------------------------------------

weight_results <- list()

agreement_results <- list()

agreement_dam_results <- list()

scenario_indices <- list()

for (s in names(scenarios)) {
  
  cat("\n====================================\n")
  cat("SCENARIO:", s, "\n")
  cat("====================================\n")
  
  # Training and test dams
  training_dams <- scenarios[[s]]
  
  test_dams <- setdiff(
    dam_levels,
    training_dams
  )
  
  # Training observations
  train_data <- dat[
    dat$DAM %in% training_dams,
    ,
    drop = FALSE
  ]
  
  # Test observations
  test_id <- which(
    dat$DAM %in% test_dams
  )
  
  test_data <- dat[
    test_id,
    ,
    drop = FALSE
  ]
  
  # ----------------------------------------------------------
  # Fit PCA on training dams only
  # ----------------------------------------------------------
  
  fitted <- calculate_weights(train_data)
  
  weights <- fitted$weights
  
  # ----------------------------------------------------------
  # Apply training weights to test observations
  # ----------------------------------------------------------
  
  transferred_indices <- calculate_indices(
    test_data,
    weights
  )
  
  # Reference indices for the same test observations
  reference_test <- reference_indices[
    test_id,
    ,
    drop = FALSE
  ]
  
  # Store transferred indices
  scenario_indices[[s]] <- transferred_indices
  
  # ----------------------------------------------------------
  # Table of WQI_P weights
  # ----------------------------------------------------------
  
  weight_results[[s]] <- data.frame(
    Scenario = s,
    Training_dams = paste(
      training_dams,
      collapse = " + "
    ),
    Testing_dams = paste(
      test_dams,
      collapse = " + "
    ),
    t(
      weights[, "WQI_P", drop = FALSE]
    ),
    check.names = FALSE
  )
  
  # ----------------------------------------------------------
  # Evaluate all three indices
  # ----------------------------------------------------------
  
  for (index in c(
    "WQI_D1",
    "WQI_D2",
    "WQI_P"
  )) {
    
    # Combined test-dam evaluation
    metrics <- calculate_agreement(
      reference_test[[index]],
      transferred_indices[[index]]
    )
    
    agreement_results[[paste(s, index, sep = "_")]] <-
      data.frame(
        Scenario = s,
        Training_dams = paste(
          training_dams,
          collapse = " + "
        ),
        Testing_dams = paste(
          test_dams,
          collapse = " + "
        ),
        Index = index,
        metrics
      )
    
    # --------------------------------------------------------
    # Evaluate each test dam separately
    # --------------------------------------------------------
    
    for (d in test_dams) {
      
      ii <- which(
        as.character(test_data$DAM) == d
      )
      
      metrics_dam <- calculate_agreement(
        reference_test[[index]][ii],
        transferred_indices[[index]][ii]
      )
      
      agreement_dam_results[[
        paste(s, d, index, sep = "_")
      ]] <- data.frame(
        Scenario = s,
        Training_dams = paste(
          training_dams,
          collapse = " + "
        ),
        Test_dam = d,
        Index = index,
        metrics_dam
      )
    }
  }
  
  cat("\nWQI_P weights:\n")
  print(round(weights[, "WQI_P"], 4))
}

