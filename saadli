library(FactoMineR)
library(dplyr)
library(tidyr)
library(ggplot2)

# ------------------------------------------------------------
# 1. DATA PREPARATION
# ------------------------------------------------------------

v4 <- c("OM", "COD", "NO3", "NO2")

lim4 <- c(
  OM = 10,
  COD = 40,
  NO3 = 50,
  NO2 = 0.9
)

# Keep only the four variables and DAM
dat <- saad[, c("DAM", v4)]

dat$DAM <- as.factor(dat$DAM)

# Ensure numerical variables
dat[, v4] <- lapply(dat[, v4], as.numeric)

# Remove incomplete observations
dat <- dat[complete.cases(dat), ]

# Check the number of dams
dam_levels <- levels(droplevels(dat$DAM))

stopifnot(length(dam_levels) == 3)

cat("Dams:", dam_levels, "\n")
cat("Observations:", nrow(dat), "\n")

# ------------------------------------------------------------
# 2. FUNCTION TO CALCULATE PCA WEIGHTS
# ------------------------------------------------------------

calculate_weights <- function(training_data) {
  
  # PCA using only four fixed variables
  pca <- PCA(
    training_data[, v4, drop = FALSE],
    scale.unit = TRUE,
    ncp = 2,
    graph = FALSE
  )
  
  # Variable contributions to PC1 and PC2
  ctb <- pca$var$contrib[
    v4,
    1:2,
    drop = FALSE
  ]
  
  # Eigenvalues
  ev <- pca$eig[1:2, 1]
  
  # Normalize PC1 contributions
  W1 <- ctb[, 1] / sum(ctb[, 1])
  
  # Normalize PC2 contributions
  W2 <- ctb[, 2] / sum(ctb[, 2])
  
  # Combined WQI_P weights
  WP <- (
    W1 * ev[1] +
      W2 * ev[2]
  ) / sum(ev)
  
  # Weight matrix
  weights <- cbind(
    WQI_D1 = W1,
    WQI_D2 = W2,
    WQI_P = WP
  )
  
  return(
    list(
      pca = pca,
      weights = weights,
      eigenvalues = ev
    )
  )
}

# ------------------------------------------------------------
# 3. FUNCTION TO CALCULATE THE THREE PCA INDICES
# ------------------------------------------------------------

calculate_indices <- function(data, weights) {
  
  # Fixed quality ratings
  q <- sweep(
    as.matrix(data[, v4, drop = FALSE]),
    2,
    lim4[v4],
    "/"
  ) * 100
  
  # Calculate all three indices
  result <- as.data.frame(
    q %*% weights
  )
  
  return(result)
}

# ------------------------------------------------------------
# 4. POOLED REFERENCE PCA
# ------------------------------------------------------------

cat("\nFitting pooled reference PCA...\n")

