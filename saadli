# 12. RANK THE SIX TRAINING SCENARIOS
# ------------------------------------------------------------

# Rank each scenario for each index and metric.
# Higher rho is better.
# Lower MAE is better.
# Higher class agreement is better.

ranking <- table_agreement %>%
  group_by(Index) %>%
  mutate(
    Rank_rho = rank(
      -Spearman_rho,
      ties.method = "average"
    ),
    Rank_MAE = rank(
      MAE,
      ties.method = "average"
    ),
    Rank_class = rank(
      -Class_agreement,
      ties.method = "average"
    )
  ) %>%
  ungroup() %>%
  group_by(Scenario, Training_dams) %>%
  summarise(
    Mean_rho = mean(Spearman_rho, na.rm = TRUE),
    Mean_MAE = mean(MAE, na.rm = TRUE),
    Mean_class_agreement = mean(
      Class_agreement,
      na.rm = TRUE
    ),
    Mean_rank = mean(
      c(Rank_rho, Rank_MAE, Rank_class),
      na.rm = TRUE
    ),
    .groups = "drop"
  ) %>%
  arrange(Mean_rank)

cat("\n====================================\n")
cat("OVERALL SCENARIO RANKING\n")
cat("====================================\n")

print(
  ranking %>%
    mutate(
      across(
        c(
          Mean_rho,
          Mean_MAE,
          Mean_class_agreement,
          Mean_rank
        ),
        ~ round(.x, 3)
      )
    )
)

