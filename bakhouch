###glm
species <- base[, 2:38]     # insect taxa
species[] <- lapply(species, as.numeric)
env <- data.frame(
  Farms       = factor(base$Farms),
  Durum_wheat = factor(base$Durum_wheat),
  Soft_wheat  = factor(base$Soft_wheat),
  Oat         = factor(base$Oat)
)
library(MASS)

glm_results <- lapply(colnames(species), function(sp) {
  
  formula <- as.formula(
    paste(sp, "~ Farms + Durum_wheat + Soft_wheat + Oat")
  )
  
  model <- glm.nb(formula, data = cbind(species, env))
  a <- anova(model, test = "Chisq")
  
  data.frame(
    Species = sp,
    Farms_p       = a["Farms", "Pr(>Chi)"],
    Durum_p       = a["Durum_wheat", "Pr(>Chi)"],
    Soft_p        = a["Soft_wheat", "Pr(>Chi)"],
    Oat_p         = a["Oat", "Pr(>Chi)"]
  )
})

glm_results <- do.call(rbind, glm_results)
summary(glm_results)
