library(ggpubr); library(vegan)

## ================= PART 1: sensitivity (Tables S1-S3, Fig. S1) =================
tit <- as.data.frame(titan.out$sppmax); tit$Taxon <- rownames(tit)
tit <- tit[, c("Taxon","ienv.cp","zscore","maxgrp","purity","reliability")]
colnames(tit) <- c("Taxon","Threshold","Z","maxgrp","Purity","Reliability")
tit <- tit[!is.na(tit$Purity) & !is.na(tit$Reliability), ]

nh4bi <- function(a_minus = 3, a_plus = 2, b = 2, cut = 0.7){
  tf <- tit[tit$Purity >= cut & tit$Reliability >= cut, ]
  tn <- (tf$Threshold - min(tf$Threshold)) / (max(tf$Threshold) - min(tf$Threshold))
  sc <- round(ifelse(tf$maxgrp == 1, 10 - tn*a_minus - b/tf$Z, 1 + tn*a_plus - b/tf$Z), 2)
  names(sc) <- tf$Taxon
  keep <- intersect(colnames(base), tf$Taxon); sc <- sc[keep]
  P <- (as.matrix(base[, keep, drop = FALSE]) > 0) * 1; P[is.na(P)] <- 0
  ok <- is.finite(sc)
  round(as.numeric(P[, ok] %*% sc[ok]) / rowSums(P[, ok]), 2)
}
cls <- function(x) cut(x, c(-Inf,2,4,6,8,Inf), right = FALSE,
                       labels = c("Very poor","Poor","Moderate","Good","Very good"))

bi_ref <- nh4bi()
