## ---- Table S4: correlation with NH4 and 95% bootstrap CI ----
TableS4 <- data.frame(
  Index = metrics,
  rho   = sapply(metrics, function(m) cor(div[, m], nh4, method = "spearman")),
  CI_low  = apply(boot, 2, quantile, 0.025),
  CI_high = apply(boot, 2, quantile, 0.975),
  row.names = NULL)

## ---- Table S5: is NH4_BI stronger than each diversity index? ----
others <- c("Richness", "Shannon", "Simpson")
TableS5 <- do.call(rbind, lapply(others, function(m) {
  d <- abs(boot[, "NH4_BI"]) - abs(boot[, m])      # difference in strength, in each re-draw
  p <- 2 * min(mean(d <= 0), mean(d >= 0))
  data.frame(Comparison = paste("NH4_BI vs", m),
             Difference = mean(d),
             CI_low = quantile(d, 0.025), CI_high = quantile(d, 0.975),
             p_value = ifelse(p == 0, "<0.001", as.character(round(p, 3))),
             row.names = NULL)
}))

## ---- Table S6: partial correlation (effect of the 3 indices removed) ----
partial <- function(i) {
  d <- div[i, ]
  bi_left  <- resid(lm(rank(bi[i])  ~ rank(d$Richness) + rank(d$Shannon) + rank(d$Simpson)))
  nh4_left <- resid(lm(rank(nh4[i]) ~ rank(d$Richness) + rank(d$Shannon) + rank(d$Simpson)))
  cor(bi_left, nh4_left)
}
pb <- numeric(B)
for (k in 1:B) pb[k] <- partial(sample(n, replace = TRUE))
TableS6 <- data.frame(Partial_rho = partial(1:n),
                      CI_low = quantile(pb, 0.025), CI_high = quantile(pb, 0.975),
                      row.names = NULL)

