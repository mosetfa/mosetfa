cf <- coef(h2); V <- vcov(h2)
ir <- grep("^s\\(espece,NH4s\\)", names(cf))
slope <- as.numeric(cf["NH4s"] + cf[ir])
se    <- as.numeric(sqrt(V["NH4s", "NH4s"] + diag(V)[ir] + 2 * V["NH4s", ir]))
fam <- data.frame(Family = levels(d$espece), slope = slope, se = se)
fam$Group <- ifelse(fam$Family %in% sens_taxa, "Sensitive (TITAN z-)",
                    ifelse(fam$Family %in% tol_taxa,  "Tolerant (TITAN z+)", "Not selected by TITAN"))
fam$OR <- exp(fam$slope); fam$lo <- exp(fam$slope - 1.96 * fam$se); fam$hi <- exp(fam$slope + 1.96 * fam$se)
fam$Family <- sub("^Sphaeridae$", "Sphaeriidae", sub("^Halipidae$", "Haliplidae", fam$Family))
fam$Family <- factor(fam$Family, levels = fam$Family[order(fam$OR)])

