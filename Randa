  select(Index, Model, MAE_Train, MAE_Test) %>%
  pivot_longer(cols = -c(Index, Model),
               names_to = "Dataset",
               names_pattern = "MAE_(.*)",
               values_to = "Value")
# Common y-axis limits
RMSE_max <- ceiling(max(metric_RMSE$Value))
MAE_max  <- ceiling(max(metric_MAE$Value))
# WQI_P
R_WQI_P <- ggplot(metric_RMSE %>% filter(Index == "WQI_P"),
                  aes(x = Model, y = Value, fill = Dataset)) +
  geom_bar(stat = "identity",
           position = position_dodge(0.9),
           color = "black") +
  geom_text(aes(label = round(Value,2)),
            position = position_dodge(0.9),
            vjust = -0.3,
            size = 3.5) +
  scale_fill_brewer(palette = "Paired") +
  scale_y_continuous(
    limits = c(0, 35),
    breaks = seq(0, 35, 5),
    expand = expansion(mult = c(0, 0.08))
  ) +
  theme_minimal(base_size = 14) +
  labs(title = "WQI_P - RMSE Train vs Test",
       x = "Algorithm",
       y = "RMSE",
       fill = "Dataset")



