###le juste krigeage###
# Charger les données
ase <- read.csv2("D:/moste/OneDrive/Bureau/Bureau/krigeage.csv")
algeria_shapefile <- st_read("D:/moste/OneDrive/Bureau/SHAPE FILE/SHP/DZA_adm/DZA_adm2/DZA_adm/DZA_adm1.shp")

# Extraire les données de Souk Ahras à partir du shapefile
Souk_ahras <- algeria_shapefile[algeria_shapefile$NAME_1 == "Souk Ahras", ]

# Convertir Souk Ahras en Spatial
Souk_ahras_sp <- as(Souk_ahras, "Spatial")

# Convertir ton fichier `base` en un objet spatial `sf` avec le CRS WGS 84
base_sf <- st_as_sf(miko, coords = c("X", "Y"), crs = 4326)

# Vérifier le CRS de `base_sf`
st_crs(base_sf)

# Transformer `base_sf` dans le CRS de Souk Ahras (WGS 84)
base_sf_transformed <- st_transform(base_sf, crs = 4326)

# Vérifier le nouveau CRS
st_crs(base_sf_transformed)

# Créer un maillage régulier à l'intérieur de la zone de Souk Ahras
# Obtenir les limites de Souk Ahras (en spatial)
bbox_souk <- st_bbox(Souk_ahras)  # Extraire les limites de la région

# Créer une grille avec un maillage régulier à l'intérieur de la bounding box de Souk Ahras
grid <- spsample(Souk_ahras_sp, n = 10000, type = "regular")

# Vérifier le nombre de points dans grid
length(grid)

# Créer un data.frame avec le bon nombre de lignes correspondant aux points dans grid
grid_df <- data.frame(AW_WQI    = rep(NA, length(grid)))

# Créer un SpatialPointsDataFrame avec la grille et le data.frame
grid_spdf <- SpatialPointsDataFrame(grid, grid_df)

# Créer un objet SpatialPointsDataFrame à partir de `base_sf`
base_sp <- as_Spatial(base_sf_transformed)

# Calculer le variogramme
variogram_model <- variogram(log(AW_WQI     ) ~ 1, base_sp)

# Visualiser le variogramme
plot(variogram_model)

# Ajuster un modèle de variogramme (modèle sphérique ici, ajuster selon tes données)
vgm_model <- vgm(1, "Sph", 100, 1)  # Ajuste ces paramètres si nécessaire

# Effectuer le krigeage
krige_result <- krige(log(AW_WQI  ) ~ 1, base_sp, grid_spdf, model = vgm_model)

# Convertir les résultats du krigeage en dataframe
krige_result_df <- as.data.frame(krige_result)

# Appliquer l'exponentielle pour obtenir les prédictions de WQI
krige_result_df$WQI <- exp(krige_result_df$var1.pred)

# Extraire les coordonnées de l'objet krige_result
coords <- coordinates(krige_result)  # Cette fonction extrait les coordonnées x et y

# Ajouter les coordonnées au dataframe
krige_result_df$x <- coords[, 1]  # Coordonnée x
krige_result_df$y <- coords[, 2]  # Coordonnée y

# Vérifier si les colonnes 'x' et 'y' sont bien ajoutées
head(krige_result_df)

# Créer la carte de l'interpolation avec ggplot
ggplot(krige_result_df, aes(x = x, y = y, fill = WQI_IPO)) +
  geom_raster() +
  scale_fill_viridis_c(option = "C") +
  coord_equal() +
  labs(
    title = "WQI Interpolation by Kriging",
    x = "Longitude", y = "Latitude", fill = "WQI"
  ) +
  theme_minimal()


