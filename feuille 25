base<-read.csv2("D:/moste/OneDrive/Bureau/Bureau/base.csv")
Souk_ahras <- st_read("D:/moste/OneDrive/Bureau/SHAPE FILE/SHP/communes_algerie_2016-10/communes_algerie4/communes_algerie.shp")
library(sf)
library(sp)
library(gstat)
library(ggplot2)
library(viridis)

# Charger base et Souk Ahras
base_sf <- st_as_sf(base, coords = c("X", "Y"), crs = 4326)


# Transformer en UTM
base_sf_utm <- st_transform(base_sf, crs = 32631)
Souk_ahras_utm <- st_transform(Souk_ahras, crs = 32631)

# Créer grille
Souk_ahras_sp <- as(Souk_ahras_utm, "Spatial")
grid <- spsample(Souk_ahras_sp, n = 50000, type = "regular")
grid_df <- data.frame(id = 1:length(grid))
grid_spdf <- SpatialPointsDataFrame(grid, grid_df)

# Conversion base
base_sp <- as_Spatial(base_sf_utm)

# IDW interpolation
idw_result <- idw(formula = IPO ~ 1, locations = base_sp, newdata = grid_spdf, idp = 2)

# Résultats
idw_result_df <- as.data.frame(idw_result)
coords <- coordinates(idw_result)
idw_result_df$x <- coords[, 1]
idw_result_df$y <- coords[, 2]

# Carte
ggplot() +
  geom_raster(data = idw_result_df, aes(x = x, y = y, fill = var1.pred)) +
  geom_sf(data = Souk_ahras_utm, fill = NA, color = "black", size = 0.5) +
  scale_fill_viridis_c(name = "AW_WQI", option = "C") +
  coord_sf(crs = 32631) +
  labs(
    title = "IDW Interpolation of OPI on Medjerda",
    x = "Longitude (m)",
    y = "Latitude (m)",
    fill = "OPI"
  ) +
  theme_minimal()

#carte avec les points des stations
ggplot() +
  # Carte interpolée
  geom_raster(data = idw_result_df, aes(x = x, y = y, fill = var1.pred)) +
  
  # Contour de la wilaya
  geom_sf(data = Souk_ahras_utm, fill = NA, color = "black", size = 0.5) +
  
  # Points des stations (base_sf_utm vient de base)
  geom_sf(data = base_sf_utm, color = "red", size = 2) +
  
  # Ajouter les noms/id des stations (basé sur la colonne "id")
  geom_text(
    data = base_sf_utm,
    aes(
      x = st_coordinates(base_sf_utm)[, 1],
      y = st_coordinates(base_sf_utm)[, 2],
      label = id
    ),
    color = "black", size = 3, vjust = -1
  ) +
  
  scale_fill_viridis_c(name = "OPI", option = "C") +
  coord_sf(crs = 32631) +
  labs(
    title = "IDW Interpolation of OPI in Souk Ahras",
    x = "Longitude (m)",
    y = "Latitude (m)",
    fill = "OPI"
  ) +
  theme_minimal()
